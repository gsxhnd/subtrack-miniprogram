<view class="tab-bar">
  <!-- 离屏 canvas -->
  <canvas type="2d" id="tabBg" class="tab-bar__offscreen" />

  <!-- 曲线背景 -->
  <image
    wx:if="{{bgImage}}"
    class="tab-bar__bg"
    src="{{bgImage}}"
    mode="aspectFill"
  />
  <!-- 兜底白色背景（图片未加载时） -->
  <view wx:else class="tab-bar__bg-fallback" />

  <!-- 中间 + 按钮（凸起顶部） -->
  <view class="tab-bar__fab" bindtap="onAdd">
    <text class="tab-bar__fab-icon">+</text>
  </view>

  <!-- Tab 项 -->
  <view class="tab-bar__tabs">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-bar__item {{selected === index ? 'is-active' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <image
        class="tab-bar__icon"
        src="{{selected === index ? item.selectedIcon : item.icon}}"
        mode="aspectFit"
      />
      <text class="tab-bar__text">{{item.text}}</text>
    </view>
  </view>
</view>
